<launch>
  <arg name="topomap_dir" default="whill_odometry_tsukuba_3.5"/>
  <arg name="wp_model" default="nomad"/>
  <arg name="pr_model" default="salad"/>
  <arg name="motion_model" default="odometry"/>
  <arg name="placenav_config" default="$(find rwrc26_bringup)/config/placenav_dev.yaml"/>
  <arg name="odom_topic" default="/odom"/>
  <!-- Empty numeric overrides preserve the selected YAML values. -->
  <arg name="odom_max_gap" default=""/>
  <arg name="odom_noise" default=""/>
  <arg name="local_pose" default="true"/>
  <arg name="local_pose_reset" default=""/>
  <arg name="wp_goal_pose" default="false"/>
  <arg name="heading_correction" default="none"/>
  <arg name="camera_hfov_deg" default=""/>
  <arg name="subgoal_update" default="arrival"/>
  <arg name="pass_threshold" default=""/>
  <arg name="pass_confirmations" default=""/>
  <arg name="pass_local_mass" default=""/>
  <arg name="goal_recovery_distance" default=""/>
  <arg name="goal_recovery_threshold" default=""/>
  <arg name="final_goal_tolerance" default=""/>
  <arg name="goal_eval_position_tolerance" default=""/>
  <arg name="goal_eval_yaw_tolerance" default=""/>
  <arg name="goal_eval_neighborhood_radius" default=""/>
  <arg name="server_host" default="127.0.0.1"/>
  <arg name="server_port" default="5557"/>
  <arg name="rviz" default="true"/>
  <arg name="navigation_visualization" default="false"/>

  <arg name="bag" default=""/>
  <arg name="bag_start" default="0.0"/>
  <arg name="bag_start_valid" value="$(eval {True: True}[0.0 &lt;= float(arg('bag_start')) &lt; float('inf')])"/>
  <arg name="bag_rate" default="1.0"/>
  <arg name="bag_pause" default="true"/>
  <arg name="bag_camera_transport" default="compressed"/>
  <arg name="play_bag" value="$(eval arg('bag') != '')"/>
  <arg name="use_sim_time" default="$(arg play_bag)"/>
  <arg name="replay_clock_valid" value="$(eval {True: True}[not arg('play_bag') or arg('use_sim_time')])"/>

  <include file="$(find rwrc26_bringup)/launch/navigation.launch">
    <arg name="topomap_dir" value="$(arg topomap_dir)"/>
    <arg name="wp_model" value="$(arg wp_model)"/>
    <arg name="pr_model" value="$(arg pr_model)"/>
    <arg name="motion_model" value="$(arg motion_model)"/>
    <arg name="placenav_config" value="$(arg placenav_config)"/>
    <arg name="odom_topic" value="$(arg odom_topic)"/>
    <arg name="odom_max_gap" value="$(arg odom_max_gap)"/>
    <arg name="odom_noise" value="$(arg odom_noise)"/>
    <arg name="local_pose" value="$(arg local_pose)"/>
    <arg name="local_pose_reset" value="$(arg local_pose_reset)"/>
    <arg name="wp_goal_pose" value="$(arg wp_goal_pose)"/>
    <arg name="heading_correction" value="$(arg heading_correction)"/>
    <arg name="camera_hfov_deg" value="$(arg camera_hfov_deg)"/>
    <arg name="subgoal_update" value="$(arg subgoal_update)"/>
    <arg name="pass_threshold" value="$(arg pass_threshold)"/>
    <arg name="pass_confirmations" value="$(arg pass_confirmations)"/>
    <arg name="pass_local_mass" value="$(arg pass_local_mass)"/>
    <arg name="goal_recovery_distance" value="$(arg goal_recovery_distance)"/>
    <arg name="goal_recovery_threshold" value="$(arg goal_recovery_threshold)"/>
    <arg name="final_goal_tolerance" value="$(arg final_goal_tolerance)"/>
    <arg name="goal_eval_position_tolerance" value="$(arg goal_eval_position_tolerance)"/>
    <arg name="goal_eval_yaw_tolerance" value="$(arg goal_eval_yaw_tolerance)"/>
    <arg name="goal_eval_neighborhood_radius" value="$(arg goal_eval_neighborhood_radius)"/>
    <arg name="server_host" value="$(arg server_host)"/>
    <arg name="server_port" value="$(arg server_port)"/>
    <arg name="rviz" value="$(arg rviz)"/>
    <arg name="navigation_visualization" value="$(arg navigation_visualization)"/>
    <arg name="gates_config" default="$(find source_costmaps)/config/gates_dev.yaml"/>
    <arg name="costmap_config" default="$(find source_costmaps)/config/costmap_dev.yaml"/>
    <arg name="bridge_config" default="$(find placenav_teb_bridge)/config/bridge_dev.yaml"/>
    <!-- Keep RViz and the costmap available after PlaceNav reaches the goal. -->
    <arg name="navigation_required" value="false"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="drive_robot" value="false"/>
    <arg name="record" value="false"/>
  </include>

  <group if="$(arg play_bag)">
    <arg name="camera_topic" value="$(eval {'compressed': '/usb_cam/image_raw/compressed', 'raw': '/usb_cam/image_raw'}[arg('bag_camera_transport')])"/>
    <arg name="pause_flag" value="$(eval '--pause' if arg('bag_pause') else '')"/>
    <node if="$(eval arg('bag_camera_transport') == 'compressed')"
          pkg="image_transport" type="republish" name="navigation_image_republish"
          args="compressed in:=/usb_cam/image_raw raw out:=/usb_cam/image_raw"/>
    <!-- Replay sensor data and TF. Recompute the C2 cloud, paths and costmap. -->
    <node pkg="rosbag" type="play" name="navigation_bag_playback" output="screen"
          args="--clock --quiet --delay=3 --start=$(arg bag_start) --rate=$(arg bag_rate) $(arg pause_flag) '$(arg bag)' --topics /tf /tf_static $(arg odom_topic) /realsense/depth/color/points /usb_cam/camera_info $(arg camera_topic)"/>
  </group>
</launch>
