<launch>
  <!-- Robot drivers/TF and the GPU model server must already be running. -->
  <arg name="image_topic" default="/usb_cam/image_raw"/>
  <arg name="server_host" default="127.0.0.1"/>
  <arg name="server_port" default="5557"/>
  <arg name="max_input_width" default="640"/>
  <arg name="cloud_stride" default="4"/>
  <arg name="placenav_src" default="/home/user/ws/src/PlaceNav/src"/>
  <arg name="topomap_dir" default="whill_odometry_tsukuba_3.5"/>
  <arg name="wp_model" default="nomad"/>
  <arg name="pr_model" default="salad"/>
  <arg name="subgoal_mode" default="place_recognition"/>
  <arg name="filter_mode" default="bayesian"/>
  <arg name="motion_model" default="odometry"/>
  <arg name="placenav_config" default="$(find rwrc26_bringup)/config/placenav.yaml"/>
  <!-- Optional numeric overrides. Empty keeps the value from placenav_config. -->
  <arg name="odom_max_gap" default=""/>
  <arg name="odom_noise" default=""/>
  <arg name="local_pose" default="true"/>
  <arg name="local_pose_reset" default=""/>
  <!-- Experimental, wp_model:=omnivla_edge with local_pose: also feed the relative subgoal pose. -->
  <arg name="wp_goal_pose" default="false"/>
  <!-- Heading measurement at subgoal switches for local_pose: none or an estimator name
       (placenav/heading_correction.py, e.g. sift_shift). Empty camera_hfov_deg = robot config. -->
  <arg name="heading_correction" default="none"/>
  <arg name="camera_hfov_deg" default=""/>
  <arg name="subgoal_update" default="arrival"/>
  <arg name="pass_threshold" default=""/>
  <arg name="pass_confirmations" default=""/>
  <arg name="pass_local_mass" default=""/>
  <arg name="goal_recovery_distance" default=""/>
  <arg name="goal_recovery_threshold" default=""/>
  <arg name="final_goal_tolerance" default=""/>
  <arg name="goal_eval_position_tolerance" default=""/>
  <!-- Legacy command-line angle override is still in radians. YAML uses degrees. -->
  <arg name="goal_eval_yaw_tolerance" default=""/>
  <arg name="goal_eval_neighborhood_radius" default=""/>
  <arg name="window_radius" default=""/>
  <arg name="start_node_idx" default="0"/>
  <arg name="goal_node_idx" default="-1"/>
  <arg name="lookahead" default=""/>
  <arg name="close_threshold" default=""/>
  <arg name="target_waypoint_idx" default=""/>
  <arg name="nomad_seed" default=""/>
  <arg name="device" default="cuda"/>
  <arg name="transition_model_window_lower" default=""/>
  <arg name="transition_model_window_upper" default=""/>
  <arg name="filter_delta" default=""/>
  <arg name="recompute_place_recognition_db" default="false"/>
  <arg name="img_size" default="[]"/>
  <arg name="navigation_visualization" default="true"/>
  <arg name="navigation_required" default="true"/>
  <!-- true: navigate.py runs on the Xavier (docker/xavier/navigate_xavier.sh); here only the
       path adapter. Requires path_timeout > 0 so TEB stops when the Xavier or the LAN stops. -->
  <arg name="remote_navigation" default="false"/>
  <!-- With remote_navigation: what runs on the Xavier. all: navigate.py (as above).
       waypoint: only the waypoint model; VPR, filter, local pose and heading correction run
       here with the path adapter and the GUI. Waypoints stop when the latest subgoal command
       is subgoal_command_timeout seconds from the Xavier's camera frame. -->
  <arg name="remote_role" default="all"/>
  <arg name="subgoal_command_timeout" default="0.6"/>
  <!-- Match bridge.launch defaults; explicit args override bridge_config. -->
  <arg name="reference_mode" default="latest"/>
  <arg name="retain_safe_path" default="false"/>
  <arg name="path_timeout" default="0.0"/>
  <arg name="shrink_horizon_backup" default="true"/>
  <arg name="global_frame" default="odom"/>
  <arg name="robot_base_frame" default="base_link"/>
  <arg name="odom_topic" default="/odom"/>
  <arg name="valid_remote" value="$(eval {True: True}[not arg('remote_navigation') or float(arg('path_timeout')) &gt; 0])"/>
  <arg name="valid_remote_role" value="$(eval {True: True}[arg('remote_role') in ['all', 'waypoint'] and float(arg('subgoal_command_timeout')) &gt; 0])"/>
  <arg name="valid_reference" value="$(eval {True: True}[arg('reference_mode') in ['state_machine', 'latest', 'avoidance_commit'] and 0 &lt;= float(arg('path_timeout')) &lt; float('inf')])"/>
  <!-- Explicit opt-in switches the planner output to the live robot topic. -->
  <arg name="drive_robot" default="false"/>
  <arg name="robot_cmd_vel_topic" default="/local_path/cmd_vel"/>
  <arg name="cmd_vel_topic" value="$(eval arg('robot_cmd_vel_topic') if arg('drive_robot') else '/fusion_validation/cmd_vel')"/>
  <arg name="fusion_mode" default="layers"/>
  <arg name="comparison_profile" default="$(eval 'matched' if arg('fusion_mode') == 'points' else 'current')"/>
  <arg name="batch_interval" default="0.1"/>
  <arg name="common_voxel_size" default="0.05"/>
  <arg name="common_decay" default="0.8"/>
  <arg name="gates_config" default="$(find source_costmaps)/config/gates.yaml"/>
  <arg name="costmap_config" default="$(find source_costmaps)/config/costmap.yaml"/>
  <arg name="bridge_config" default="$(find placenav_teb_bridge)/config/bridge.yaml"/>
  <arg name="record" default="true"/>
  <arg name="diagnostics" default="false"/>
  <arg name="bag_dir" default="/home/user/ws/src/PlaceNav/bag"/>
  <!-- rosbag record -o: bag_dir must exist; files are named <bag_prefix>_YYYY-MM-DD-HH-MM-SS.bag. -->
  <arg name="bag_prefix" default="navigation"/>
  <arg name="bag_buffer_mb" default="512"/>
  <!-- Navigation and retained-path diagnostics. Some depend on the installed PlaceNav version;
       rosbag also subscribes to topics that are not currently published. -->
  <arg name="record_topics" default="
    /usb_cam/image_raw/compressed
    /usb_cam/camera_info
    /odom
    /tf
    /tf_static
    /c2/depth/points
    /c2/depth/diagnostics
    /toponav/localization_diagnostics
    /toponav/goal_evaluation
    /toponav/local_goal_pose
    /toponav/viz_info
    /toponav/reached_goal
    /placenav/gnm_path
    /placenav_teb_bridge/local_costmap/costmap
    /placenav_teb_bridge/local_costmap/footprint
    /placenav_teb_bridge/TebLocalPlannerROS/global_plan
    /placenav_teb_bridge/TebLocalPlannerROS/local_plan
    /placenav_teb_bridge/TebLocalPlannerROS/teb_poses
    /placenav_teb_bridge/TebLocalPlannerROS/teb_markers
    /placenav_teb_bridge/navigation_state
    /local_path/cmd_vel
    /whill/controller/cmd_vel
    /realsense/color/image_raw/compressed
    /realsense/color/camera_info
    /placenav_teb_bridge/control_status
    /realsense/depth/camera_info
    /realsense/depth/image_rect_raw/compressedDepth
    /placenav_teb_bridge/retained_safe_path
    /placenav_teb_bridge/diagnostics"/>
  <arg name="debug_costmaps" default="false"/>
  <arg name="rviz" default="true"/>
  <arg name="use_sim_time" default="false"/>
  <param name="use_sim_time" value="$(arg use_sim_time)" type="bool"/>

  <include file="$(find unidepth_ros)/launch/c2_unidepth.launch">
    <arg name="image_topic" value="$(arg image_topic)"/>
    <arg name="frame_id" value="c2_camera_optical_frame"/>
    <arg name="camera_mode" value="auto"/>
    <arg name="max_input_width" value="$(arg max_input_width)"/>
    <arg name="cloud_stride" value="$(arg cloud_stride)"/>
    <arg name="server_host" value="$(arg server_host)"/>
    <arg name="server_port" value="$(arg server_port)"/>
  </include>

  <include file="$(find source_costmaps)/launch/pipeline.launch">
    <arg name="global_frame" value="$(arg global_frame)"/>
    <arg name="robot_base_frame" value="$(arg robot_base_frame)"/>
    <arg name="gates_config" value="$(arg gates_config)"/>
    <arg name="fusion_mode" value="$(arg fusion_mode)"/>
    <arg name="comparison_profile" value="$(arg comparison_profile)"/>
    <arg name="batch_interval" value="$(arg batch_interval)"/>
    <arg name="common_voxel_size" value="$(arg common_voxel_size)"/>
    <arg name="common_decay" value="$(arg common_decay)"/>
  </include>

  <rosparam command="load" file="$(arg bridge_config)" ns="placenav_teb_bridge"/>
  <include file="$(find source_costmaps)/launch/load_costmap.launch">
    <arg name="global_frame" value="$(arg global_frame)"/>
    <arg name="robot_base_frame" value="$(arg robot_base_frame)"/>
    <arg name="target_ns" value="/placenav_teb_bridge"/>
    <arg name="config" value="$(arg costmap_config)"/>
    <arg name="fusion_mode" value="$(arg fusion_mode)"/>
    <arg name="comparison_profile" value="$(arg comparison_profile)"/>
    <arg name="common_voxel_size" value="$(arg common_voxel_size)"/>
    <arg name="common_decay" value="$(arg common_decay)"/>
  </include>
  <!-- Build the selected obstacle layers inside the planner's own Costmap2DROS.
       Do not also launch bridge.launch or standalone costmaps.launch. -->
  <node pkg="placenav_teb_bridge" type="placenav_teb_bridge_node" name="placenav_teb_bridge"
        output="screen" required="true">
    <param name="cmd_vel_topic" value="$(arg cmd_vel_topic)"/>
    <param name="diagnostics_enabled" value="$(arg diagnostics)"/>
    <param name="retain_safe_path" value="$(arg retain_safe_path)"/>
    <param name="reference_mode" value="$(arg reference_mode)"/>
    <param name="path_timeout" type="double" value="$(arg path_timeout)"/>
    <param name="TebLocalPlannerROS/shrink_horizon_backup" type="bool" value="$(arg shrink_horizon_backup)"/>
    <param name="TebLocalPlannerROS/map_frame" value="$(arg global_frame)"/>
    <param name="TebLocalPlannerROS/odom_topic" value="$(arg odom_topic)"/>
  </node>

  <node pkg="rwrc26_bringup" type="session_runner.py" name="placenav_runner"
        output="screen" required="$(arg navigation_required)" clear_params="true">
    <rosparam command="load" file="$(arg placenav_config)"/>
    <param name="placenav_config" value="$(arg placenav_config)"/>
    <env name="OPENBLAS_NUM_THREADS" value="1"/>
    <param name="placenav_src" value="$(arg placenav_src)"/>
    <param name="topomap_dir" value="$(arg topomap_dir)"/>
    <param name="wp_model" value="$(arg wp_model)"/>
    <param name="pr_model" value="$(arg pr_model)"/>
    <param name="subgoal_mode" value="$(arg subgoal_mode)"/>
    <param name="filter_mode" value="$(arg filter_mode)"/>
    <param name="motion_model" value="$(arg motion_model)"/>
    <param name="odom_topic" value="$(arg odom_topic)"/>
    <param if="$(eval arg('odom_max_gap') != '')" name="odom_max_gap" value="$(arg odom_max_gap)" type="double"/>
    <param if="$(eval arg('odom_noise') != '')" name="odom_noise" value="$(arg odom_noise)" type="double"/>
    <param name="local_pose" value="$(arg local_pose)" type="bool"/>
    <param if="$(eval arg('local_pose_reset') != '')" name="local_pose_reset" value="$(arg local_pose_reset)" type="bool"/>
    <param name="wp_goal_pose" value="$(arg wp_goal_pose)" type="bool"/>
    <param name="heading_correction" value="$(arg heading_correction)"/>
    <param if="$(eval arg('camera_hfov_deg') != '')" name="camera_hfov_deg" value="$(arg camera_hfov_deg)" type="double"/>
    <param name="subgoal_update" value="$(arg subgoal_update)"/>
    <param if="$(eval arg('pass_threshold') != '')" name="pass_threshold" value="$(arg pass_threshold)" type="double"/>
    <param if="$(eval arg('pass_confirmations') != '')" name="pass_confirmations" value="$(arg pass_confirmations)" type="int"/>
    <param if="$(eval arg('pass_local_mass') != '')" name="pass_local_mass" value="$(arg pass_local_mass)" type="double"/>
    <param if="$(eval arg('goal_recovery_distance') != '')" name="goal_recovery_distance" value="$(arg goal_recovery_distance)" type="double"/>
    <param if="$(eval arg('goal_recovery_threshold') != '')" name="goal_recovery_threshold" value="$(arg goal_recovery_threshold)" type="double"/>
    <param if="$(eval arg('final_goal_tolerance') != '')" name="final_goal_tolerance" value="$(arg final_goal_tolerance)" type="double"/>
    <param if="$(eval arg('goal_eval_position_tolerance') != '')" name="goal_eval_position_tolerance" value="$(arg goal_eval_position_tolerance)" type="double"/>
    <param if="$(eval arg('goal_eval_yaw_tolerance') != '')" name="goal_eval_yaw_tolerance" value="$(arg goal_eval_yaw_tolerance)" type="double"/>
    <param if="$(eval arg('goal_eval_neighborhood_radius') != '')" name="goal_eval_neighborhood_radius" value="$(arg goal_eval_neighborhood_radius)" type="double"/>
    <param if="$(eval arg('window_radius') != '')" name="window_radius" value="$(arg window_radius)"/>
    <param name="start_node_idx" value="$(arg start_node_idx)"/>
    <param name="goal_node_idx" value="$(arg goal_node_idx)"/>
    <param if="$(eval arg('lookahead') != '')" name="lookahead" value="$(arg lookahead)"/>
    <param if="$(eval arg('close_threshold') != '')" name="close_threshold" value="$(arg close_threshold)"/>
    <param if="$(eval arg('target_waypoint_idx') != '')" name="target_waypoint_idx" value="$(arg target_waypoint_idx)"/>
    <param if="$(eval arg('nomad_seed') != '')" name="nomad_seed" value="$(arg nomad_seed)"/>
    <param name="device" value="$(arg device)"/>
    <param if="$(eval arg('transition_model_window_lower') != '')" name="transition_model_window_lower" value="$(arg transition_model_window_lower)"/>
    <param if="$(eval arg('transition_model_window_upper') != '')" name="transition_model_window_upper" value="$(arg transition_model_window_upper)"/>
    <param if="$(eval arg('filter_delta') != '')" name="filter_delta" value="$(arg filter_delta)"/>
    <param name="recompute_place_recognition_db" value="$(arg recompute_place_recognition_db)"/>
    <rosparam param="img_size" subst_value="true">$(arg img_size)</rosparam>
    <param name="global_frame" value="$(arg global_frame)"/>
    <param name="robot_base_frame" value="$(arg robot_base_frame)"/>
    <param name="visualization" value="$(arg navigation_visualization)"/>
    <param name="diagnostics" value="$(arg diagnostics)"/>
    <param name="drive_robot" value="$(arg drive_robot)"/>
    <param name="cmd_vel_topic" value="$(arg cmd_vel_topic)"/>
    <param name="remote_navigation" value="$(arg remote_navigation)"/>
    <param name="remote_role" value="$(arg remote_role)"/>
    <param name="subgoal_command_timeout" value="$(arg subgoal_command_timeout)" type="double"/>
  </node>

  <node if="$(arg record)" pkg="rosbag" type="record" name="session_recorder" output="screen"
        required="true"
        args="-o $(arg bag_dir)/$(arg bag_prefix) --lz4 --buffsize $(arg bag_buffer_mb) $(arg record_topics)"/>

  <!-- Optional visualization-only second costmap instance. Gates/TF are shared.
       This snapshot is not the planner's actual costmap update boundary. -->
  <include if="$(arg debug_costmaps)" file="$(find source_costmaps)/launch/load_costmap.launch">
    <arg name="global_frame" value="$(arg global_frame)"/>
    <arg name="robot_base_frame" value="$(arg robot_base_frame)"/>
    <arg name="target_ns" value="/obstacles/source_costmaps"/>
    <arg name="config" value="$(arg costmap_config)"/>
    <arg name="fusion_mode" value="$(arg fusion_mode)"/>
    <arg name="comparison_profile" value="$(arg comparison_profile)"/>
    <arg name="common_voxel_size" value="$(arg common_voxel_size)"/>
    <arg name="common_decay" value="$(arg common_decay)"/>
  </include>
  <node if="$(arg debug_costmaps)" pkg="source_costmaps" type="source_costmaps_node" name="source_costmaps"
        ns="obstacles" output="screen">
  </node>
  <node if="$(arg local_pose)" pkg="rwrc26_bringup" type="local_goal_visualizer.py"
        name="local_goal_visualizer" output="screen">
    <param name="target_frame" value="$(arg global_frame)"/>
  </node>
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="navigation_rviz"
        args="-d $(find rwrc26_bringup)/rviz/navigation.rviz"/>
</launch>
